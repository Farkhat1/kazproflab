{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/prerender.mjs",
    "build:netlify": "playwright install chromium && npm run build && node scripts/prepare-netlify.mjs && npm run test:netlify",
    "content:sync": "node scripts/sync-content.mjs",
    "preview": "node scripts/serve-static.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:netlify": "node --test tests/netlify-output.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.4",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
